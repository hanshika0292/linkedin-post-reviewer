# Copy to .env.local and fill in values from your Supabase project
# (Supabase dashboard -> Project Settings -> API Keys, and the "Connect" panel).

# Project URL, used by the browser, the auth proxy and cookie-based sign-in.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable (client-safe) key, used for team sign-in sessions.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Same project URL, read by server-only code and scripts/create-team-member.mjs.
SUPABASE_URL=https://your-project-ref.supabase.co

# Service-role / secret key. Server only: it bypasses Row Level Security. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Direct (non-pooled) Postgres connection string, only used by the psql setup commands in the README.
POSTGRES_URL_NON_POOLING=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
